# Copy the keys you need into AgentV2/.env (the project-root .env is the one that is read).
# Keys marked (required) have no default in code; everything else falls back to the value shown.

# --- Claude via Azure AI Foundry (required for --mode hybrid) ---
FOUNDRY_ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
FOUNDRY_API_KEY=<secret>
FOUNDRY_MODEL_DEPLOYMENT=<deployment-name>

# --- Langfuse tracing (optional; tracing is off when missing) ---
LANGFUSE_SECRET_KEY=<secret>
LANGFUSE_PUBLIC_KEY=<public-key>
LANGFUSE_BASE_URL=https://<langfuse-host>

# =====================================================================
# Site. Change these for another site; the values below are derived
# from them unless you set the override explicitly.
# =====================================================================
FL_SITE_NAME=Bokor                 # file names + prompts
FL_SITE_CODE=BOKOR                 # top node of the FLOC hierarchy (Inventory 3); default = FL_SITE_NAME upper-case
FL_PLANT_CODE=M014
FL_COMPANY_NAME=PETRONAS

# --- Input ---
FL_INPUT_SOURCE=cache              # cache = FL/Equipment sheets from the asset master cache; excel = files below
FL_DATASET=both                    # both | fl | equipment | auto
FL_INPUT_SHEET=0                   # Excel sheet index or name
FL_INPUT_FILE=FL_<SITE_NAME>.xlsx  # single input file (--dataset fl / equipment)
FL_FL_INPUT_FILE=                  # FL sheet file for --dataset both (empty = FL_INPUT_FILE)
FL_EQ_INPUT_FILE=                  # Equipment sheet file for --dataset both (empty = FL_INPUT_FILE)

# --- Derived from the site (override only if your names differ) ---
FL_OUTPUT_FILE=outputs/FL_<SITE_NAME>_validated.xlsx
FL_FL_OUTPUT_FILE=outputs/FL/FL_<SITE_NAME>_validated.xlsx
FL_EQ_OUTPUT_FILE=outputs/Eq/Equipment_<SITE_NAME>_validated.xlsx
FL_ECA_TABLE=<site_name>_eca_report                     # in the public schema
FL_ECA_DIR=<SITE_CODE> ECA REPORT
FL_ECA_EXTRACT_DIR=<SITE_CODE> ECA REPORT
FL_ECA_REPORT_FALLBACK=<SITE_CODE> ECA REPORT/ECA_Extract.xlsx
FL_ASSET_CACHE_FILE=cache/<site_name>/asset_master_cache.pkl
FL_TRACE_TAG=<site_name>-validation

# --- Shared folders ---
FL_STANDARDS_DIR=STANDARDS
FL_CACHE_DIR=cache_agent
FL_STANDARDS_KB_FILE=cache_agent/standards_kb.json
FL_PROCESS_SUBPROCESS_FALLBACK=STANDARDS/process_subprocess_extracted.xlsx
FL_CATALOG_PROFILE_FALLBACK=STANDARDS/Catalog_Profile_COMPLETE_Extraction.xlsx

# --- PostgreSQL asset master (Azure AD auth via `az login`) ---
FL_DB_HOST=<server>.postgres.database.azure.com          # (required)
FL_DB_NAME=<database>                                    # (required)
FL_DB_USER=<user@domain>                                 # (required)
FL_DB_TENANT_ID=<azure-tenant-id>                        # (required)
FL_DB_TOKEN_SCOPE=https://ossrdbms-aad.database.windows.net/.default   # (required)
FL_DB_PORT=5432
FL_DB_SSLMODE=require
FL_DB_CONNECT_TIMEOUT=30

# --- Claude client limits ---
FL_LLM_MAX_TOKENS=16000
FL_LLM_MAX_RETRIES=4
FL_LLM_TIMEOUT_SECONDS=600

# --- Langfuse labels ---
FL_AGENT_NAME=Agent A
