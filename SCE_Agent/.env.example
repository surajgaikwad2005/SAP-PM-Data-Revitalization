# Copy this file to ".env" (same folder) and fill in the values.
# Needed only for `python run_sce_agent.py --with-llm`; the default run makes no LLM calls.

# Langfuse - every LLM call is traced (project "SAP PM Data Revitalization")
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Self-hosted LLM (OpenAI-compatible, vLLM) - the default provider of the LLM steps
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Azure AI Foundry (optional providers)
AZURE_GPT_ENDPOINT=
AZURE_GPT_DEPLOYMENT=
AZURE_GPT_API_KEY=
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_DEPLOYMENT=
AZURE_CLAUDE_API_KEY=
